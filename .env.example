# Copy to .env and fill in real values. Generate secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# ---- App ----
DOMAIN=localhost
FRONTEND_HOST=http://localhost:5173
ENVIRONMENT=local
PROJECT_NAME="Quizzer"
STACK_NAME=quizzer

# ---- Security ----
SECRET_KEY=changethis
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# ---- First admin (seeded on first run) ----
FIRST_SUPERUSER=admin@quizzer.local
FIRST_SUPERUSER_PASSWORD=changethis

# ---- CORS (comma-separated origins) ----
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:3001"

# ---- Database (Postgres runs in Docker; app connects over localhost) ----
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=quizzer
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# ---- Uploads ----
UPLOAD_DIRECTORY=static/pictures

# ---- Email (optional; disabled when SMTP_HOST is empty) ----
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@quizzer.local
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# ---- Observability (optional) ----
SENTRY_DSN=
