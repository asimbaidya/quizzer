# ---- Application ----
PROJECT_NAME="Quizzer"

# ---- Security ----
# Generate a strong key with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="change-me-generate-a-real-secret"
# Access token lifetime in minutes (default: 8 days)
ACCESS_TOKEN_EXPIRE_MINUTES=11520

# ---- Database ----
# For local dev against a native Postgres:
POSTGRES_URI="postgresql+psycopg://postgres:postgres@127.0.0.1:5432/quizzer"

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
BACKEND_CORS_ORIGINS="http://localhost:3001,http://localhost:5173"

# ---- Uploads ----
UPLOAD_DIRECTORY="static/pictures"
